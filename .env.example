# App Setup
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Database (Drizzle ORM)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/your_database
DIRECT_URL=postgresql://postgres:your_password@localhost:5432/your_database

# CloudHike Auth
AUTH_URL=https://your-project.cloudhike.dev/auth
AUTH_PUBLISHABLE_KEY=your-publishable-key
AUTH_SECRET_KEY=your-secret-key

# CloudHike Storage (S3-compatible)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# CloudHike Jobs (runs screen generation in the background)
JOBS_API_URL=
JOBS_API_KEY=
# The URL Jobs calls this app on. Defaults to NEXT_PUBLIC_APP_URL. Jobs refuses localhost,
# so in development use a tunnel, e.g. `ngrok http 3000`.
# JOBS_PUBLIC_URL=
# How long one build step (one screen) can take: up to 300 on Free, 3600 on Pro. Defaults to 300.
# JOBS_TIMEOUT_SECONDS=

# Connect to CloudHike: lets people use their own CloudHike account as their app's backend.
# Create the app in CloudHike under Settings > API & apps > Developer apps, and register this
# callback URL exactly: <NEXT_PUBLIC_APP_URL>/api/cloudhike/callback
CLOUDHIKE_CLIENT_ID=
CLOUDHIKE_CLIENT_SECRET=
# Encrypts people's CloudHike tokens and credentials in the database. Changing it means everyone
# has to connect again and connected apps stop working until then. Generate: openssl rand -base64 32
CLOUDHIKE_ENCRYPTION_KEY=

# Push to GitHub: lets people push their app's code to their own GitHub repositories.
# Create an OAuth app under GitHub > Settings > Developer settings > OAuth Apps, and register this
# callback URL exactly: <NEXT_PUBLIC_APP_URL>/api/github/callback
# Tokens are encrypted with CLOUDHIKE_ENCRYPTION_KEY above, so that has to be set too.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 1 turns on outside services for generated apps (services, keys and server functions)
APP_INTEGRATIONS=

# ImageKit: stores, generates, and transforms the images in people's apps. When true, and with both
# keys set, the agent generates its images with ImageKit and edit mode has the AI image tools. Otherwise
# apps use placeholder images, and an image can only be changed by its url.
IMAGEKIT_ENABLED=false
# Both are under Developer options in the ImageKit dashboard. The private key stays on the server.
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Stripe: charges for the Pro plan. Create a monthly recurring price in the Stripe dashboard and put its id here.
# Add a webhook endpoint at <NEXT_PUBLIC_APP_URL>/api/billing/webhook for customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted, invoice.paid,
# checkout.session.completed, and checkout.session.async_payment_succeeded. Its signing secret goes below.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
# One-time credit top-ups on the "Credit top-up" product. Each price is one-time, in USD,
# and its metadata.credits is how many credits that pack adds. These credits never expire.
# 100 credits = $5, 400 credits = $15, 1,000 credits = $29.
STRIPE_TOPUP_100_PRICE_ID=
STRIPE_TOPUP_400_PRICE_ID=
STRIPE_TOPUP_1000_PRICE_ID=
# The price the pricing page shows. Keep it the same as the Stripe price. Defaults to $19.
# NEXT_PUBLIC_PRO_PRICE_LABEL=$19

# Anthropic AI (OpenAI-compatible endpoint, used by the OpenAI Agents SDK)
AI_BASE_URL=https://api.anthropic.com/v1/
AI_API_KEY=your-anthropic-api-key
# Optional model overrides (defaults to anthropic/claude-sonnet-5.5)
# AI_MODEL=
# AI_BUILDER_MODEL=
# How many screens an app plan has at most, unless the person asks for more (1 to 10, defaults to 3)
DEFAULT_SCREEN_COUNT=3

# Tavily web search: lets the agent research outside services (with APP_INTEGRATIONS=1).
# Get a key at https://app.tavily.com. AppxPrompt pays for it; each search costs 1 credit.
# Without it the agent can still read docs pages it knows the address of.
TAVILY_API_KEY=

# Sentry: error monitoring and tracing. The DSN is a public client key.
NEXT_PUBLIC_SENTRY_DSN=
# Auth token for uploading source maps during production builds. Create one in
# Sentry → Settings → Auth Tokens, with project:releases and org:read.
# SENTRY_AUTH_TOKEN=

# Server functions while building run in Vercel Sandbox. "vercel" turns it on; anything else answers "unavailable".
# On Vercel, auth is automatic (OIDC). Locally: `vercel link` and `vercel env pull`, or set VERCEL_TEAM_ID, VERCEL_PROJECT_ID and VERCEL_TOKEN.
SANDBOX_PROVIDER=
# Comma-separated user ids that may run server functions in a sandbox, e.g. 12,40. Empty means everyone.
# Set this to your own user id for the first production run.
SANDBOX_ALLOWED_USERS=
